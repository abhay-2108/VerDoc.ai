{
    "manifest_version": 3,
    "name": "VeriDoc.ai Analyzer",
    "version": "1.0",
    "description": "Multi-agent document analyzer for professional workflows.",
    "permissions": [
        "activeTab",
        "storage"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'"
    }
}